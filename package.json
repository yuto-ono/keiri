{
  "name": "keiri",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.22.1",
    "pnpm": "12.15.0"
  },
  "imports": {
    "#lib/styles/*": "./src/lib/styles/*",
    "#lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "dev": "node --env-file=.env node_modules/vite/bin/vite.js dev",
    "keiri": "node --env-file=.env src/cli.ts",
    "build": "vite build",
    "start": "HOST=127.0.0.1 node --env-file=.env build",
    "prepare": "svelte-kit sync",
    "sync": "svelte-kit sync",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "bignumber.js": "11.1.5",
    "commander": "15.0.0",
    "date-fns": "4.4.0",
    "pdf-lib": "1.17.1",
    "playwright": "1.64.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
